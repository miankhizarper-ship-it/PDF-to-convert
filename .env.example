# ─────────────────────────────────────────────────────────────
# ORBITAL//CYBER — environment variables
# Copy to `.env.local` for development. Never commit real values.
# Only variables prefixed with NEXT_PUBLIC_ reach the browser —
# keep database credentials and secrets server-side.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (server-side only).
# Atlas → Database → Connect → Drivers → copy the SRV string.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database + collection used for contact submissions.
MONGODB_DB="portfolio"
MONGODB_COLLECTION="messages"

# Secret used to sign the anti-spam form token (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_FORM_SECRET="replace-with-a-long-random-string"

# Public origin — used for metadataBase, canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Without MONGODB_URI the API refuses to fake success in production (HTTP 503).
# Set this to "true" to accept messages and log them to the server console
# instead — useful before the database is wired up. Never needed in dev.
CONTACT_ALLOW_LOG_ONLY="false"

# Optional rate limiting for POST /api/contact (per IP, sliding window).
CONTACT_RATE_LIMIT_MAX="5"
CONTACT_RATE_LIMIT_WINDOW_MS="600000"
